#!/bin/sh
# commit-msg フック: gitmoji(任意) + Conventional Commits を検証。
# 有効化: git config core.hooksPath scripts/hooks
set -e

MSG_FILE="$1"
HEADER=$(sed -n '1p' "$MSG_FILE")

# merge/revert/fixup 等は許可
case "$HEADER" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*) exit 0 ;;
esac

# 先頭の gitmoji（絵文字 or :shortcode:）を任意で許容してから type を必須化
TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
PATTERN="^([^[:alnum:][:space:]]+ ?|:[a-z0-9_+-]+: ?)?(${TYPES})(\([^)]+\))?!?: .+"

if printf '%s' "$HEADER" | grep -Eq "$PATTERN"; then
  exit 0
fi

cat >&2 <<'EOF'
✗ コミットメッセージが規約に反します（gitmoji 任意 + Conventional Commits）。

  形式: [<gitmoji>] <type>(<scope>)!: <subject>
  type: feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert

  例:   :sparkles: feat: ...
        fix(install): ...

詳細: docs/commit-convention.md
EOF
exit 1
