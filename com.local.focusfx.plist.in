<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.focusfx</string>

    <!-- @@BIN@@ / @@HOME@@ は install.sh が実行時に
         自己発見した絶対パスへ置換する（ユーザー名非依存）。 -->
    <key>ProgramArguments</key>
    <array>
        <string>@@BIN@@</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>@@HOME@@/.local/state/focusfx.out.log</string>

    <key>StandardErrorPath</key>
    <string>@@HOME@@/.local/state/focusfx.err.log</string>
</dict>
</plist>
